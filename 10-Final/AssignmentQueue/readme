On the counteragent.cpp file i add more Leds :

/***
 * Contructor
 * @param gp1 GPIO PAD for 1st LED - units
 * @param gp2 GPIO PAD for 1st LED - 2
 * @param gp3 GPIO PAD for 1st LED - 4
 * @param gp4 GPIO PAD for 1st LED - 8
 * @param gp5 GPIO PAD for 1st LED - 16
 * @param gp6 GPIO PAD for 1st LED - 32
 * @param gp7 GPIO PAD for 1st LED - 64
 * @param gp8 GPIO PAD for 1st LED - 128
 */
CounterAgent::CounterAgent(uint8_t gp1, uint8_t gp2, uint8_t gp3, uint8_t gp4,uint8_t gp5,uint8_t gp6,uint8_t gp7,uint8_t gp8) {

	pLedPads[0] = gp1;
	pLedPads[1] = gp2;
	pLedPads[2] = gp3;
	pLedPads[3] = gp4;
	pLedPads[4] = gp5;
	pLedPads[5] = gp6;
	pLedPads[6] = gp7;
	pLedPads[7] = gp8;

On the counteragent.h i change the #define COUNT_LEDS 4 to #define COUNT_LEDS 7 and this change :
/***
 	* Contructor
 	* @param gp1 GPIO PAD for 1st LED - units
 	* @param gp2 GPIO PAD for 1st LED - 2
 	* @param gp3 GPIO PAD for 1st LED - 4
 	* @param gp4 GPIO PAD for 1st LED - 8
 	* @param gp5 GPIO PAD for 1st LED - 16
 	* @param gp6 GPIO PAD for 1st LED - 32
 	* @param gp7 GPIO PAD for 1st LED - 64
 	* @param gp8 GPIO PAD for 1st LED - 128
 	*/
	CounterAgent(uint8_t gp1=0, uint8_t gp2=0, uint8_t gp3=0, uint8_t gp4=0,uint8_t gp5=0,uint8_t gp6=0,uint8_t gp7=0,uint8_t gp8=0);
